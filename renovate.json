{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "workarounds:all"
  ],
  "reviewers": [
    "DreierF"
  ],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "ignorePaths": [
    "report-generator/build.gradle.kts"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchFileNames": [
        "system-tests/**"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "system-tests/**/gradle/wrapper/gradle-wrapper.properties"
      ],
      "matchManagers": [
        "gradle-wrapper"
      ],
      "enabled": true
    },
    {
      "description": "This and the following rules keep the runtime dependencies of the profiler on the version lines known to run on Java 11. Raise a limit only after checking that the next line still supports Java 11.",
      "matchPackageNames": [
        "ch.qos.logback:*"
      ],
      "allowedVersions": "< 1.7.0"
    },
    {
      "description": "Jersey 4 requires Java 17",
      "matchPackageNames": [
        "org.glassfish.jersey*:*"
      ],
      "allowedVersions": "< 3.2.0"
    },
    {
      "matchPackageNames": [
        "jakarta.activation:*"
      ],
      "allowedVersions": "< 2.2.0"
    },
    {
      "description": "JCommander 3 requires Java 17",
      "matchPackageNames": [
        "org.jcommander:jcommander"
      ],
      "allowedVersions": "< 3"
    },
    {
      "matchPackageNames": [
        "org.jacoco:*"
      ],
      "allowedVersions": "< 0.9.0"
    },
    {
      "matchPackageNames": [
        "org.slf4j:*"
      ],
      "allowedVersions": "< 2.1.0"
    },
    {
      "description": "Jackson 3 requires Java 17",
      "matchPackageNames": [
        "com.fasterxml.jackson*:*"
      ],
      "allowedVersions": "< 3"
    },
    {
      "matchPackageNames": [
        "com.squareup.retrofit2:*"
      ],
      "allowedVersions": "< 4"
    },
    {
      "matchPackageNames": [
        "com.squareup.okhttp3:*"
      ],
      "allowedVersions": "< 6"
    },
    {
      "matchPackageNames": [
        "commons-codec:commons-codec"
      ],
      "allowedVersions": "< 2"
    },
    {
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-coroutines-*"
      ],
      "allowedVersions": "< 2"
    },
    {
      "matchPackageNames": [
        "org.junit:junit-bom"
      ],
      "matchFileNames": [
        "impacted-test-engine/build.gradle.kts"
      ],
      "allowedVersions": "< 6"
    },
    {
      "matchPackageNames": [
        "com.teamscale:teamscale-jacoco-agent",
        "com.teamscale:teamscale-client"
      ],
      "enabled": false
    }
  ]
}
